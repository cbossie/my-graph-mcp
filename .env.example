# Copy to .env and fill in your own values. .env is git-ignored.

# Entra app registration (Application/client ID and Directory/tenant ID)
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_TENANT_ID=11111111-1111-1111-1111-111111111111

# Your tenant's SharePoint host (required when LISTS_VIEWS is true in src/auth.js)
SHAREPOINT_ROOT_HOST=contoso.sharepoint.com

# Optional overrides
# GRAPH_SCOPES=Notes.ReadWrite.All Mail.ReadWrite
# GRAPH_TOKEN_CACHE=C:\Users\you\.graph-mcp\token_cache.bin
